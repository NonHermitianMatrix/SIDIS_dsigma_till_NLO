(* Hqq_LO_traces.wls -- Steps L1+L2 (shakedown): gamma* q -> q(k1) g(k2),
   quark fragments. Amplitude typed from the Feynman rules (FeynArts banned),
   k2 eliminated via momentum conservation (k2 = p + q - k1) so only p, q, k1
   appear. Check 2 (gauge invariance), then M2g, M2PP, export to
   python/generated/Hqq_L2_M2.py.
   Run: timeout 900 wolframscript -file mathematica/Hqq_LO_traces.wls
        > mathematica/Hqq_LO_traces.log 2>&1                                *)

$HistoryLength = 0;
<< FeynCalc`
Print["[1] FeynCalc loaded"];
<< FeynHelpers`
Print["[2] FeynHelpers loaded"];

SetDirectory["/home/physics/projects/AI_Assisted_SIDIS"];

(* ---------- kinematics: all scalar products in terms of s, t, Q2 ---------- *)
FCClearScalarProducts[];
u = -s - t - Q2;                       (* 2->2: s + t + u = -Q2 *)
SPD[p, p]   = 0;  SPD[k1, k1] = 0;  SPD[q, q] = -Q2;
SPD[p, q]   = (s + Q2)/2;              (* s  = (p+q)^2  = 2 p.q - Q2   *)
SPD[q, k1]  = -(t + Q2)/2;             (* t  = (q-k1)^2 = -Q2 - 2 q.k1 *)
SPD[p, k1]  = -u/2;                    (* u  = (p-k1)^2 = -2 p.k1      *)
Print["[3] scalar products set"];

(* ---------- L1: amplitude from the Feynman rules ---------- *)
(* diagram 1: photon then gluon, quark propagator (p+q), 1/s
   diagram 2: gluon then photon, quark propagator (p-k2) = (k1-q), 1/t
   couplings/colour (eq ee gs T^a) factored out; squared prefactor below *)
amp1 = SpinorUBarD[k1] . GAD[nu] . (GSD[p] + GSD[q]) . GAD[mu] . SpinorUD[p]/s;
amp2 = SpinorUBarD[k1] . GAD[mu] . (GSD[k1] - GSD[q]) . GAD[nu] . SpinorUD[p]/t;
amp  = amp1 + amp2;
Print["[4] amplitude built, leafcount ", LeafCount[amp]];

(* ---------- check 2: gauge invariance, q_mu M^mu -> 0 ---------- *)
gc = DiracSimplify[Contract[FVD[q, mu] amp]] // Simplify;
Print["[5] check 2 (q_mu M^mu, must be 0): ", gc // InputForm];

(* ---------- L2: square, spin sum, traces, projections ---------- *)
ampC = ComplexConjugate[amp] /. {mu -> mu2, nu -> nu2};
spinsum = MemoryConstrained[
   DiracSimplify[FermionSpinSum[amp ampC]], 4*10^9];
Print["[6] spin sum + traces done, leafcount ", LeafCount[spinsum]];

colour = SUNSimplify[SUNTrace[SUNT[a, a]], SUNNToCACF -> False];
Print["[7] colour factor Tr[T^a T^a] = ", colour // InputForm];
pref = eq^2 ee^2 gs^2 colour/(2 SUNN);   (* avg: 1/2 spin, 1/SUNN colour *)

(* gluon polarization sum -> -g^{nu nu2} (valid: check 2 holds);
   photon polarization replaced by +g^{mu mu2} (M2g) and p^mu p^mu2 (M2PP) *)
M2g  = MemoryConstrained[Simplify[
   (Contract[MTD[mu, mu2] (-MTD[nu, nu2]) spinsum] /. D -> 4 - 2 eps) pref], 4*10^9];
M2PP = MemoryConstrained[Simplify[
   (Contract[FVD[p, mu] FVD[p, mu2] (-MTD[nu, nu2]) spinsum] /. D -> 4 - 2 eps) pref], 4*10^9];
Print["[8] M2g  = ", M2g // InputForm];
Print["[8] M2PP = ", M2PP // InputForm];
Print["[8] TeX M2g:  ", ToString[TeXForm[M2g]]];
Print["[8] TeX M2PP: ", ToString[TeXForm[M2PP]]];

(* ---------- check 5 precursor: no eps poles at k1T != 0 (structural) ---------- *)
Print["[9] eps-free denominators (True expected): ",
  FreeQ[Denominator[Together[M2g]], eps] && FreeQ[Denominator[Together[M2PP]], eps]];

(* ---------- V1 smoke test: Package-X reachable through FeynHelpers ---------- *)
b0test = TimeConstrained[PaXEvaluate[B0[s, 0, 0]], 120, "PAX-TIMEOUT"];
Print["[10] PaXEvaluate[B0[s,0,0]] = ", b0test // InputForm];

(* ---------- save + export ---------- *)
Save["mathematica/Hqq_LO_traces_steps.m", {M2g, M2PP}];
pyStr[e_] := StringReplace[
   ToString[e /. SUNN -> Nc, InputForm, PageWidth -> Infinity], "^" -> "**"];
str = "# generated by mathematica/Hqq_LO_traces.wls (L1+L2)\n" <>
  "# gamma* q -> q g (quark fragments), n = 4 - 2 eps, spin/colour averaged\n" <>
  "# M2g: photon pol sum -> +g^{mu nu}; M2PP: -> p^mu p^nu; gluon sum -> -g\n" <>
  "from sympy import sympify\n" <>
  "M2g  = sympify('" <> pyStr[M2g]  <> "')\n" <>
  "M2PP = sympify('" <> pyStr[M2PP] <> "')\n";
Export["python/generated/Hqq_L2_M2.py", str, "Text"];
Print["[11] exported -> python/generated/Hqq_L2_M2.py"];
Print["DONE"];
