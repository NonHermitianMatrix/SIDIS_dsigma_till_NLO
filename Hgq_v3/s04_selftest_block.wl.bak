(* ================= self test ==========================================
   Compare the full machinery (partial fractioning -> frames -> angular
   integrals) against direct 2D numerical integration of the same integrand
   at a physical phase-space point.                                          *)
If[Environment["HGQ_SKIPTEST"] === "1", Goto[afterSelfTest]];
kin = {Q2 -> 1, s -> 4, t -> -2, u -> -1};
Print["[s04] self-test point ", kin, "  s23=", s23e /. kin,
   "  D=", N[(2 Q2 + s + t)/Sqrt[(s + t)^2 + 4 Q2 s23e] /. kin, 10],
   "  cos(p,q)=", N[cpq /. kin, 10], "  cos(k1,q)=", N[ckq /. kin, 10],
   "  cos(p,k1)=", N[cpk /. kin, 10]];

numAng[expr_, ev_] := Module[{integ, f},
  integ = (expr /. {t2 -> admvAng["F3"]["t2"], u2 -> admvAng["F3"]["u2"]}) /. kin;
  f = integ /. {c1 -> Cos[b1], s1 -> Sin[b1], cb2 -> Cos[b2]};
  Quiet@NIntegrate[Evaluate[N[Sin[b1]^(1 - 2 ev) Sin[b2]^(-2 ev) f]],
   {b1, 0, Pi}, {b2, 0, Pi}, AccuracyGoal -> 10, PrecisionGoal -> 7,
   MaxRecursion -> 60,
   Method -> {"GlobalAdaptive", "SymbolicProcessing" -> 0, "SingularityDepth" -> 10}]];

(* group A: denominators are t-type only -> integrand regular over the whole
   angular region, so the numerics are decisive.
   group B: light-like denominators -> integrable only for eps<0, looser. *)
testsA = {1, 1/admv["t2"], 1/admv["t2"]^2, 1/(admv["t2"] admv["t3"]),
   admv["s13"]/admv["t2"], admv["u2"] admv["u3"]/admv["t2"]^2, admv["t3"]/admv["t2"]^2};
labA = {"1", "1/t2", "1/t2^2", "1/(t2 t3)", "s13/t2", "u2 u3/t2^2", "t3/t2^2"};
testsB = {admv["t3"]/admv["u2"], 1/(admv["u2"] admv["u3"]), 1/(admv["u2"] admv["s13"]),
   1/(admv["t2"] admv["u2"]), 1/(admv["t2"] admv["u2"] admv["s13"])};
labB = {"t3/u2", "1/(u2 u3)", "1/(u2 s13)", "1/(t2 u2)", "1/(t2 u2 s13)"};

runTests[tst_, lab_, e1_, e2_] := Do[Module[{sym, red, n1, n2, r1, r2},
    red = reduceAll[splitMonomials[prepare[tst[[i]]]]];
    sym = Normal[Series[Total[integrateTerm /@ red] /. kin, {eps, 0, 1}]];
    n1 = numAng[tst[[i]], N[e1]]; n2 = numAng[tst[[i]], N[e2]];
    r1 = N[(sym /. eps -> N[e1]) - n1]; r2 = N[(sym /. eps -> N[e2]) - n2];
    Print["  ", lab[[i]], "  terms=", Length[red], "  resid(", N[e1], ")=",
      ScientificForm[r1, 3], "  resid(", N[e2], ")=", ScientificForm[r2, 3],
      "  ratio=", If[Abs[r2] > 10^-13, N[r1/r2, 4], "-"], " (expect ~4)"];
    ], {i, Length[tst]}];

Print["[s04] group A (regular integrands, decisive):"];
runTests[testsA, labA, 1/50, 1/100];
If[Environment["HGQ_SKIPB"] === "1",
  Print["[s04] group B skipped (HGQ_SKIPB=1): its numerics are unreliable for singular integrands"],
  Print["[s04] group B (light-like denominators, eps<0):"];
  runTests[testsB, labB, -1/10, -1/20]];

If[selfTestOnly, Print["[s04] self-test only, exiting"]; Quit[0]];

Label[afterSelfTest];