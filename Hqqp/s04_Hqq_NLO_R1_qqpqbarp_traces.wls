(* Hqq_NLO_R1_qqpqbarp_traces.wls -- Step R1, subprocess (c) of Hqq:
   gamma*(q,mu) + q(p) -> q(k1) + q'(k2) + qbar'(k3)   [Hqq;q'qbar', case A]
   Two diagrams: photon before/after the gluon emission on the beam line;
   gluon propagator (k2+k3), Feynman gauge, splits into the q'qbar' pair.
   Also pins the V1 Package-X convention (PaXEvaluateUVIRSplit of B0).
   Run: timeout 1800 wolframscript -file mathematica/Hqq_NLO_R1_qqpqbarp_traces.wls
        > mathematica/Hqq_NLO_R1_qqpqbarp_traces.log 2>&1                       *)

$HistoryLength = 0;
$LoadAddOns = {"FeynHelpers"};
<< FeynCalc`
If[!ValueQ[$FeynHelpersDirectory],
  Print["FATAL: FeynHelpers failed to load"]; Quit[1]];
Print["[1] FeynCalc + FeynHelpers loaded, guard passed"];

SetDirectory["/home/physics/projects/AI_Assisted_SIDIS"];

(* ---------- V1 convention pin: UV/IR-split B0 with the reference prefactor ---------- *)
b0split = TimeConstrained[
  PaXEvaluateUVIRSplit[B0[ss, 0, 0], PaXImplicitPrefactor -> 1/(2 Pi)^D],
  180, "PAX-TIMEOUT"];
Print["[2] PaXEvaluateUVIRSplit[B0[ss,0,0], prefactor 1/(2Pi)^D] = ",
  b0split // InputForm];

(* ---------- 2->3 invariants: all scalar products, NO conservation imposed ---------- *)
FCClearScalarProducts[];
SPD[p, p] = 0; SPD[q, q] = -Q2;
SPD[k1, k1] = 0; SPD[k2, k2] = 0; SPD[k3, k3] = 0;
SPD[p, q]  = (s + Q2)/2;          (* s   = (p+q)^2   = 2 p.q - Q2  *)
SPD[q, k1] = -(t1 + Q2)/2;        (* ti  = (q-ki)^2  = -Q2 - 2 q.ki *)
SPD[q, k2] = -(t2 + Q2)/2;
SPD[q, k3] = -(t3 + Q2)/2;
SPD[p, k1] = -u1/2;               (* ui  = (p-ki)^2  = -2 p.ki      *)
SPD[p, k2] = -u2/2;
SPD[p, k3] = -u3/2;
SPD[k1, k2] = s12/2;              (* sij = (ki+kj)^2 = 2 ki.kj      *)
SPD[k1, k3] = s13/2;
SPD[k2, k3] = s23/2;
Print["[3] scalar products set (invariants s,Q2,t1..t3,u1..u3,s12,s13,s23)"];

(* ---------- amplitude from the Feynman rules ---------- *)
(* beam line, photon first (quark propagator p+q, 1/s) or gluon first
   (propagator k1-q, 1/t1); gluon -g^{al be}/s23 to the pair current *)
chain1 = SpinorUBarD[k1] . GAD[al] . (GSD[p] + GSD[q]) . GAD[mu] . SpinorUD[p]/s +
         SpinorUBarD[k1] . GAD[mu] . (GSD[k1] - GSD[q]) . GAD[al] . SpinorUD[p]/t1;
chain2 = SpinorUBarD[k2] . GAD[al] . SpinorVD[k3];
amp = -chain1 chain2/s23;         (* couplings eq ee gs^2, colour T^a x T^a in pref *)
Print["[4] amplitude built, leafcount ", LeafCount[amp]];

(* ---------- check 2: gauge invariance ---------- *)
gc = DiracSimplify[Contract[FVD[q, mu] amp]] // Together;
Print["[5] check 2 (q_mu M^mu, must be 0): ", gc // InputForm];

(* ---------- square, spin sums, projections ---------- *)
ampC = ComplexConjugate[amp] /. {mu -> mu2, al -> al2};
spinsum = MemoryConstrained[DiracSimplify[FermionSpinSum[amp ampC]], 5*10^9];
Print["[6] spin sums + traces done, leafcount ", LeafCount[spinsum]];

colour = SUNSimplify[SUNTrace[SUNT[a, b]] SUNTrace[SUNT[a, b]],
   SUNNToCACF -> False];
Print["[7] colour factor Tr[T^aT^b]Tr[T^aT^b] = ", colour // InputForm];
pref = eq^2 ee^2 gs^4 colour/(2 SUNN);   (* avg: 1/2 spin, 1/SUNN colour *)

MR2gA  = MemoryConstrained[Together[
   (Contract[MTD[mu, mu2] spinsum] /. D -> 4 - 2 eps) pref], 5*10^9];
MR2PPA = MemoryConstrained[Together[
   (Contract[FVD[p, mu] FVD[p, mu2] spinsum] /. D -> 4 - 2 eps) pref], 5*10^9];
Print["[8] MR2gA leafcount ", LeafCount[MR2gA],
  ", MR2PPA leafcount ", LeafCount[MR2PPA]];

(* denominators must be angle-INdependent (AIMV = s, t1, s23 only) *)
dens = Union[Cases[{Denominator[MR2gA], Denominator[MR2PPA]},
   _Symbol, Infinity]];
Print["[9] symbols in denominators (subset of {s,t1,s23,SUNN} expected): ", dens];

Save["mathematica/Hqq_NLO_R1_qqpqbarp_steps.m", {MR2gA, MR2PPA}];

pyStr[e_] := StringReplace[
   ToString[e /. SUNN -> Nc, InputForm, PageWidth -> Infinity], "^" -> "**"];
str = "# generated by mathematica/Hqq_NLO_R1_qqpqbarp_traces.wls (R1, case c)\n" <>
  "# gamma* q -> q(k1) q'(k2) qbar'(k3): Hqq;q'qbar' real channel, charge case A\n" <>
  "# invariants: s,Q2,t1,t2,t3,u1,u2,u3,s12,s13,s23 (NO conservation imposed);\n" <>
  "# spin/colour averaged; MR2g: photon sum -> +g; MR2PP: -> p^mu p^nu\n" <>
  "from sympy import sympify\n" <>
  "MR2gA  = sympify('" <> pyStr[MR2gA]  <> "')\n" <>
  "MR2PPA = sympify('" <> pyStr[MR2PPA] <> "')\n";
Export["python/generated/Hqq_R1_qqpqbarp.py", str, "Text"];
Print["[10] exported -> python/generated/Hqq_R1_qqpqbarp.py"];
Print["DONE"];
