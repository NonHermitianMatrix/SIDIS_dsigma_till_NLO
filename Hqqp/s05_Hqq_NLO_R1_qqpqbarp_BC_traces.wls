(* Hqq_NLO_R1_qqpqbarp_BC_traces.wls -- Step R1, charge cases B and C of the
   different-flavor real channel of Hqq:
     gamma*(q,mu) + q(p) -> q(k1) + q'(k2) + qbar'(k3)   (q' != q, q fragments)
   Two amplitudes:
     G = photon on the BEAM quark line (charge e_q),   gluon momentum k2+k3
         (propagator 1/s23) -- this is the case-A amplitude of the sister
         script Hqq_NLO_R1_qqpqbarp_traces.wls.
     H = photon on the PAIR quark line (charge e_q'),   gluon momentum p-k1
         (propagator 1/u1), photon attaches to q'(k2) [prop 1/t2] or
         qbar'(k3) [prop 1/t3].
   |H|^2   -> case C (e_q'^2);   2 Re(G Hconj) -> case B (e_q e_q').
   G and H each carry ONE exchanged gluon between the two open quark lines,
   so the colour factor is Tr[T^aT^b]Tr[T^aT^b] = (Nc^2-1)/4 for both squares
   and the interference; distinct gluon Lorentz indices alg (G) and alh (H)
   are used so the interference does not spuriously share indices.
   Run: timeout 1800 wolframscript -file mathematica/Hqq_NLO_R1_qqpqbarp_BC_traces.wls
        > mathematica/Hqq_NLO_R1_qqpqbarp_BC_traces.log 2>&1                  *)

$HistoryLength = 0;
<< FeynCalc`
Print["[1] FeynCalc loaded"];
SetDirectory["/home/physics/projects/AI_Assisted_SIDIS"];

(* ---------- 2->3 invariants: all scalar products, NO conservation imposed ---------- *)
FCClearScalarProducts[];
SPD[p, p] = 0; SPD[q, q] = -Q2;
SPD[k1, k1] = 0; SPD[k2, k2] = 0; SPD[k3, k3] = 0;
SPD[p, q]  = (s + Q2)/2;          (* s   = (p+q)^2   = 2 p.q - Q2  *)
SPD[q, k1] = -(t1 + Q2)/2;        (* ti  = (q-ki)^2  = -Q2 - 2 q.ki *)
SPD[q, k2] = -(t2 + Q2)/2;
SPD[q, k3] = -(t3 + Q2)/2;
SPD[p, k1] = -u1/2;               (* ui  = (p-ki)^2  = -2 p.ki      *)
SPD[p, k2] = -u2/2;
SPD[p, k3] = -u3/2;
SPD[k1, k2] = s12/2;              (* sij = (ki+kj)^2 = 2 ki.kj      *)
SPD[k1, k3] = s13/2;
SPD[k2, k3] = s23/2;
Print["[2] scalar products set"];

(* ---------- amplitudes from the Feynman rules ---------- *)
(* G: photon on beam (charge e_q), gluon index alg, gluon momentum k2+k3 -> 1/s23 *)
Gbeam = SpinorUBarD[k1] . GAD[alg] . (GSD[p] + GSD[q]) . GAD[mu] . SpinorUD[p]/s +
        SpinorUBarD[k1] . GAD[mu] . (GSD[k1] - GSD[q]) . GAD[alg] . SpinorUD[p]/t1;
Gpair = SpinorUBarD[k2] . GAD[alg] . SpinorVD[k3];
Gamp  = -Gbeam Gpair/s23;

(* H: photon on pair (charge e_q'), gluon index alh, gluon momentum p-k1 -> 1/u1 *)
Hbeam = SpinorUBarD[k1] . GAD[alh] . SpinorUD[p];
Hpair = SpinorUBarD[k2] . GAD[mu] . (GSD[k2] - GSD[q]) . GAD[alh] . SpinorVD[k3]/t2 +
        SpinorUBarD[k2] . GAD[alh] . (GSD[q] - GSD[k3]) . GAD[mu] . SpinorVD[k3]/t3;
Hamp  = -Hbeam Hpair/u1;
Print["[3] amplitudes built; leafcounts G ", LeafCount[Gamp], " H ", LeafCount[Hamp]];

(* ---------- check 2: gauge invariance of H (must be 0) ---------- *)
gcH = DiracSimplify[Contract[FVD[q, mu] Hamp]] // Together;
Print["[4] check 2 (q_mu H^mu, must be 0): ", gcH // InputForm];

(* ---------- colour + prefactors ---------- *)
colour = SUNSimplify[SUNTrace[SUNT[a, b]] SUNTrace[SUNT[a, b]], SUNNToCACF -> False];
Print["[5] colour Tr[T^aT^b]^2 = ", colour // InputForm];
prefC = eqp^2 ee^2 gs^4 colour/(2 SUNN);   (* e_q'^2 *)
prefB = eq eqp ee^2 gs^4 colour/(2 SUNN);  (* e_q e_q' *)

(* ---------- case C: |H|^2, projected ---------- *)
HampC = ComplexConjugate[Hamp] /. {mu -> mu2, alh -> alh2};
ssC = MemoryConstrained[DiracSimplify[FermionSpinSum[Hamp HampC]], 5*10^9];
Print["[6] |H|^2 spin sum done, leafcount ", LeafCount[ssC]];
MR2gC  = MemoryConstrained[Together[
   (Contract[MTD[mu, mu2] ssC] /. D -> 4 - 2 eps) prefC], 5*10^9];
MR2PPC = MemoryConstrained[Together[
   (Contract[FVD[p, mu] FVD[p, mu2] ssC] /. D -> 4 - 2 eps) prefC], 5*10^9];
Print["[7] MR2gC leafcount ", LeafCount[MR2gC], ", MR2PPC leafcount ", LeafCount[MR2PPC]];

(* ---------- case B: 2 Re(G Hconj), projected ---------- *)
GampC = ComplexConjugate[Gamp] /. {mu -> mu2, alg -> alg2};
HampCb = ComplexConjugate[Hamp] /. {mu -> mu2, alh -> alh2};
ssB = MemoryConstrained[
   DiracSimplify[FermionSpinSum[Gamp HampCb] + FermionSpinSum[Hamp GampC]],
   5*10^9];
Print["[8] interference spin sum done, leafcount ", LeafCount[ssB]];
MR2gB  = MemoryConstrained[Together[
   (Contract[MTD[mu, mu2] ssB] /. D -> 4 - 2 eps) prefB], 5*10^9];
MR2PPB = MemoryConstrained[Together[
   (Contract[FVD[p, mu] FVD[p, mu2] ssB] /. D -> 4 - 2 eps) prefB], 5*10^9];
Print["[9] MR2gB leafcount ", LeafCount[MR2gB], ", MR2PPB leafcount ", LeafCount[MR2PPB]];

(* ---------- structural guard: indices closed, D eliminated ---------- *)
If[!FreeQ[{MR2gB, MR2PPB, MR2gC, MR2PPC}, D] ||
   !FreeQ[{MR2gB, MR2PPB, MR2gC, MR2PPC}, LorentzIndex],
  Print["FATAL: stray D or open Lorentz index"]; Quit[1]];
Print["[10] structural guard passed"];

Save["mathematica/Hqq_NLO_R1_qqpqbarp_BC_steps.m", {MR2gB, MR2PPB, MR2gC, MR2PPC}];
pyStr[e_] := StringReplace[
   ToString[e /. SUNN -> Nc, InputForm, PageWidth -> Infinity], "^" -> "**"];
str = "# generated by mathematica/Hqq_NLO_R1_qqpqbarp_BC_traces.wls (R1, cases B,C)\n" <>
  "# gamma* q -> q(k1) q'(k2) qbar'(k3): photon on the q'qbar' pair line.\n" <>
  "# MR2*C: |H|^2 (e_q'^2, case C); MR2*B: 2Re(G H*) (e_q e_q', case B).\n" <>
  "# invariants s,Q2,t1,t2,t3,u1,u2,u3,s12,s13,s23 (NO conservation imposed);\n" <>
  "# spin/colour averaged; MR2g: photon sum -> +g; MR2PP: -> p^mu p^nu\n" <>
  "from sympy import sympify\n" <>
  "MR2gB  = sympify('" <> pyStr[MR2gB]  <> "')\n" <>
  "MR2PPB = sympify('" <> pyStr[MR2PPB] <> "')\n" <>
  "MR2gC  = sympify('" <> pyStr[MR2gC]  <> "')\n" <>
  "MR2PPC = sympify('" <> pyStr[MR2PPC] <> "')\n";
Export["python/generated/Hqq_R1_qqpqbarp_BC.py", str, "Text"];
Print["[11] exported -> python/generated/Hqq_R1_qqpqbarp_BC.py"];
Print["DONE"];
