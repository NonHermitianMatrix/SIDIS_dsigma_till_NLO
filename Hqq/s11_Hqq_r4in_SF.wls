#!/usr/bin/env wolframscript
(* Bridge the SF (Hqq;q'qbar') angular terms into r4in_ form.  (0z.403)

   python/Hqq_r4in_from_classes.py handles QGG and PAIR, whose R3 classes are
   keyed (j,l,epsg) and so can be pushed through each R4 module's _pieces().
   ** The SF cannot go that route: its R3 classes are keyed by 2-TUPLES, a
   different object entirely (0z.371, where the same assumption already cost a
   run). **

   But the SF's angular terms ALREADY EXIST in Mathematica as
   mathematica/Hqq_SF_classes.m -- entries {epsOrder, expr} where expr is
   e(s23), the integrand whose s23^-1 coefficient IS the endpoint residue.
   That is exactly what `angterms` means to
   verified/_shared/Hqq_R4_mma_part2.wls.  So flatten them:
       angterms = { eps^n * expr, ... }
   No round-trip through sympy (0z.381), no re-derivation.

   BRANCH: 'pos' is used.  Both branches give the same regular sector -- the
   branch lives only at s23 = 0, and 0z.360 measured identical leaf counts for
   pos and neg.  Recorded rather than hidden.

   The SF has ONLY the (0,0) class (STATE 13473), which TERMINATES exactly, so
   there is no 2F1 endpoint rule and no eps^2 PolyLog anywhere in it -- the
   0z.364 landmine does not touch this piece. *)

$HistoryLength = 0;
dir = DirectoryName[$InputFileName];
Get[FileNameJoin[{dir, "Hqq_SF_classes.m"}]];
If[! ValueQ[sfPPpos], Print["FATAL: Hqq_SF_classes.m did not load"]; Quit[1]];

(* ***** RESOLVE THE BRANCH BEFORE EXPORT (STATE.md 0z.342 defect (c)) *****
   The SF classes carry Sqrt[(Q2+u1)^2] = |Q2-U| together with denominators
   1/(Q2 + u1 -/+ root) that VANISH IDENTICALLY on one branch.  Handing those
   to the R4 engine unresolved is what made r4in_MR2{PP,g}DFA fail the
   ComplexInfinity-free gate while QGG and PAIR passed.
   THE ONLY ORDER OF OPERATIONS THAT WORKS, quoted from 0z.342:
     replace the root by a SYMBOL rr; Together/Cancel; reduce the numerator
     MODULO rr^2 - (Q2+u1)^2 (which is what makes the removable singularity
     actually cancel); and ONLY THEN set rr -> sgn (Q2+u1).
   Substituting the root's VALUE directly leaves 1/0 -- Mathematica evaluates
   the vanishing denominator before anything can cancel.  A literal
   Sqrt[(Q2+u1)^2] rule also does not fire (it is stored as
   Power[Power[Q2+u1,2],1/2]), so the match is on any 1/2-power whose radicand
   is that perfect square.
   BRANCH: sgn = +1 ("pos").  Both branches give the same regular sector -- the
   branch lives only at s23 = 0 (0z.360 measured identical leaf counts). *)
resolveBranch[e_, sgn_] := Module[{x},
  x = e /. Power[pp_, Rational[1, 2]] :> rr /;
        Simplify[pp - (Q2 + u1)^2] === 0;
  If[FreeQ[x, rr], Return[e]];
  x = Cancel[Together[x]];
  x = PolynomialReduce[Numerator[x], {rr^2 - (Q2 + u1)^2}, {rr}][[2]]/
      Cancel[Denominator[x]];
  Cancel[Together[x /. rr -> sgn (Q2 + u1)]]];

Do[Module[{piece = p[[1]], data = p[[2]], strm, n = 0},
   strm = OpenWrite[FileNameJoin[{dir, "r4in_" <> piece <> ".m"}]];
   WriteString[strm,
     "(* angterms for " <> piece <> ", generated by mathematica/Hqq_r4in_SF.wls\n" <>
     "   from Hqq_SF_classes.m (branch pos).  Entries are eps^n e(s23);\n" <>
     "   the SF has only the (0,0) class, so no 2F1 rule and no PolyLog. *)\n"];
   WriteString[strm, "angterms = {\n"];
   Do[WriteString[strm,
        If[n > 0, ",\n", ""] <>
        ToString[InputForm[eps^ent[[1]] resolveBranch[ent[[2]], 1]]]];
      n++, {ent, data}];
   WriteString[strm, "\n};\n"];
   Close[strm];
   Print["  wrote r4in_", piece, ".m  (", n, " angular terms)"]],
  {p, {{"MR2PPDFA", sfPPpos}, {"MR2gDFA", sfgpos}}}];
Print["HQQ_R4IN_SF_DONE"];
