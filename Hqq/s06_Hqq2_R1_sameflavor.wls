#!/usr/bin/env wolframscript
(* Hqq (channel 2), REBUILD -- step R1, SAME-FLAVOUR graphs Hqq;q qbar.

       gamma*(q) + q(p) -> q(k1) + q(k2) + qbar(k3) ,  ALL SAME FLAVOUR

   The final state has TWO IDENTICAL QUARKS (k1, k2), so the amplitude is the
   different-flavour amplitude ANTISYMMETRIZED under k1 <-> k2.  This is a
   physical identical-particle configuration, NOT the q <-> qbar spectator
   reversal the paper forbids (p.16, bookkeeping section 3).

   THE BUG THIS SCRIPT FIXES (job 14200076).  The first attempt wrote the
   exchange as `ampDF /. {k1 -> k2, k2 -> k1}`, which swaps the momenta inside
   the spinors and gamma matrices but LEAVES THE INVARIANT SYMBOLS in the
   propagator denominators untouched.  The gauge check caught it:

     q_mu M^mu = -((t1-t2)(eqp s23 t1 - eq t2 u1)(...))/(s23 t1 t2 u1)  != 0

   Two things were wrong, both visible in that residue:
     * the (t1 - t2) factor: the exchange must ALSO relabel the invariants,
           t1 <-> t2 ,  u1 <-> u2 ,  s13 <-> s23 ,   (s12, s, Q2 invariant)
       because ti = (q-ki)^2, ui = (p-ki)^2, sij = (ki+kj)^2;
     * the (eqp ... - eq ...) mixing: for SAME flavour there is only ONE
       charge, so eqp -> eq throughout BEFORE antisymmetrizing.

   Output: python/generated/Hqq2_R1_sameflavor.py   (MR2gSF, MR2PPSF)
*)

$HistoryLength = 0;
<< FeynCalc`

root = "/home/physics/projects/AI_Assisted_SIDIS";
If[StringQ[Environment["SIDIS_ROOT"]] && Environment["SIDIS_ROOT"] =!= "",
  root = Environment["SIDIS_ROOT"]];
Print["[1] FeynCalc loaded; root = ", root];

FCClearScalarProducts[];
SPD[p, p] = 0; SPD[q, q] = -Q2;
SPD[k1, k1] = 0; SPD[k2, k2] = 0; SPD[k3, k3] = 0;
SPD[p, q]  = (s + Q2)/2;
SPD[q, k1] = -(t1 + Q2)/2;
SPD[q, k2] = -(t2 + Q2)/2;
SPD[q, k3] = -(t3 + Q2)/2;
SPD[p, k1] = -u1/2;
SPD[p, k2] = -u2/2;
SPD[p, k3] = -u3/2;
SPD[k1, k2] = s12/2;
SPD[k1, k3] = s13/2;
SPD[k2, k3] = s23/2;
Print["[2] invariants set"];

(* ---- the different-flavour amplitude, with ONE charge (same flavour) --- *)
obsLine = SpinorUBarD[k1] . GAD[al] . (GSD[p] + GSD[q]) . GAD[mu] . SpinorUD[p]/s +
          SpinorUBarD[k1] . GAD[mu] . (GSD[k1] - GSD[q]) . GAD[al] . SpinorUD[p]/t1;
pairPlain = SpinorUBarD[k2] . GAD[al] . SpinorVD[k3];
obsPlain  = SpinorUBarD[k1] . GAD[al] . SpinorUD[p];
pairPhoton =
  SpinorUBarD[k2] . GAD[mu] . (GSD[k2] - GSD[q]) . GAD[al] . SpinorVD[k3]/t2 +
  SpinorUBarD[k2] . GAD[al] . (GSD[q] - GSD[k3]) . GAD[mu] . SpinorVD[k3]/t3;

ampDirect = -eq (obsLine pairPlain/s23 + obsPlain pairPhoton/u1);
gcD = DiracSimplify[Contract[FVD[q, mu] ampDirect]] // Together;
Print["[3] check 2 on the direct term (must be 0): ", Simplify[gcD] // InputForm];
If[!TrueQ[Simplify[gcD] === 0],
  Print["FATAL: direct term not gauge invariant"]; Quit[1]];

(* ---- the exchange: momenta AND invariants together -------------------- *)
swap = {k1 -> k2, k2 -> k1,
        t1 -> t2, t2 -> t1,
        u1 -> u2, u2 -> u1,
        s13 -> s23, s23 -> s13};
ampExchange = ampDirect /. swap;
gcX = DiracSimplify[Contract[FVD[q, mu] ampExchange]] // Together;
Print["[4] check 2 on the exchange term (must be 0): ", Simplify[gcX] // InputForm];
If[!TrueQ[Simplify[gcX] === 0],
  Print["FATAL: exchange term not gauge invariant"]; Quit[1]];

ampSF = ampDirect - ampExchange;       (* Fermi antisymmetry, identical k1,k2 *)
gcSF = DiracSimplify[Contract[FVD[q, mu] ampSF]] // Together;
Print["[5] check 2 on the FULL SF amplitude (must be 0): ",
  Simplify[gcSF] // InputForm];
If[!TrueQ[Simplify[gcSF] === 0],
  Print["FATAL: SF amplitude not gauge invariant"]; Quit[1]];
Print["[6] SF amplitude leafcount ", LeafCount[ampSF]];

colour = SUNSimplify[SUNTrace[SUNT[a, b]] SUNTrace[SUNT[a, b]],
   SUNNToCACF -> False];
pref = ee^2 gs^4 colour/(2 SUNN);
conj[x_] := ComplexConjugate[x] /. {mu -> mu2, al -> al2};
spinsum = MemoryConstrained[
  DiracSimplify[FermionSpinSum[ampSF conj[ampSF]]], 6*10^9];
Print["[7] SF spinsum leafcount ", LeafCount[spinsum]];

MR2gSF  = Together[(Contract[MTD[mu, mu2] spinsum] /. D -> 4 - 2 eps) pref];
MR2PPSF = Together[
  (Contract[FVD[p, mu] FVD[p, mu2] spinsum] /. D -> 4 - 2 eps) pref];
Print["[8] MR2gSF ", LeafCount[MR2gSF], "  MR2PPSF ", LeafCount[MR2PPSF]];

If[!FreeQ[MR2gSF, D] || !FreeQ[MR2PPSF, D],
  Print["FATAL: D survives"]; Quit[1]];
If[!FreeQ[MR2gSF, LorentzIndex] || !FreeQ[MR2PPSF, LorentzIndex],
  Print["FATAL: open Lorentz indices survive"]; Quit[1]];

nm[e_] := StringReplace[ToString[e // FortranForm], "SUNN" -> "Nc"];
out = FileNameJoin[{root, "python", "generated", "Hqq2_R1_sameflavor.py"}];
Export[out, StringJoin[
  "# generated by mathematica/Hqq2_R1_sameflavor.wls (Hqq REBUILD, step R1)\n",
  "# Hqq;q qbar -- SAME flavour, antisymmetrized under k1 <-> k2 with the\n",
  "# invariants relabelled (t1<->t2, u1<->u2, s13<->s23) and eqp -> eq.\n",
  "MR2gSF = \"\"\"", nm[MR2gSF], "\"\"\"\n\n",
  "MR2PPSF = \"\"\"", nm[MR2PPSF], "\"\"\"\n"], "Text"];
Print["[9] exported ", out];
Print["HQQ2_R1_SF_DONE"];
