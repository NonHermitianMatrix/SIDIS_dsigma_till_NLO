 "CandidateDefinitions" -> 
  {HoldPattern[spinPolynomialZero[value_, spinVariables_]] :> 
    Module[{expanded, rows, monomials, reconstructed}, 
     gate["spin check polynomial", PolynomialQ[value, spinVariables]]; 
      expanded = Expand[value, Alternatives @@ spinVariables]; 
      If[expanded === 0, Return[True]]; rows = CoefficientRules[expanded, 
        spinVariables]; monomials = 
       (Times @@ MapThread[Power, {spinVariables, First[#1]}] & ) /@ rows; 
      reconstructed = Total[MapThread[Times, {Last /@ rows, monomials}]]; 
      gate["spin check full polynomial reconstruction", 
       Collect[expanded - reconstructed, spinVariables, 
         Factor[Together[#1]] & ] === 0]; 
      And @@ (TrueQ[Factor[Together[#1]] === 0] & ) /@ Last /@ rows]}, 
