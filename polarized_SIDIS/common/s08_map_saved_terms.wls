(* Map original additive terms with the accepted reference functions. *)
$HistoryLength=0;root=Directory[];channel=Environment["POLARIZED_SIDIS_CHANNEL"];checks=<||>;
source=FileNameJoin[{root,"common","s08_map_saved_terms.wls"}];
gate[name_,test_]:=If[TrueQ[test],If[!KeyExistsQ[checks,name],Print["PASS: ",name]];AssociateTo[checks,name->True],Print["FAIL: ",name];If[TrueQ[$KernelID>0],Throw[$Failed,"TermFailure"],CloseKernels[];Quit[1]]];
SetAttributes[bounded,HoldFirst];
bounded[value_,label_]:=MemoryConstrained[TimeConstrained[value,1800,gate[ToString[{label,"time"},InputForm],False]],4*1024^3,gate[ToString[{label,"memory"},InputForm],False]];
zero[value_]:=Factor[Together[value]]===0;
gate["compute allocation",StringQ[Environment["JOB_ID"]]&&!StringStartsQ[$MachineName,"login"]&&StringStartsQ[$UserBaseDirectory,root<>"/"]];
gate["selected native channel",MemberQ[{"Hqg","Hgg"},channel]];
PrependTo[$Path,"/u/home/r/rushil/.Mathematica/Applications"];$FeynCalcStartupMessages=False;$LoadAddOns={"FeynArts"};Get["FeynCalc`"];
gate["complete term mapper syntax",SyntaxQ[Import[source,"Text"]]];
component=If[channel==="Hqg",4,8];
inputRelative=channel<>"/s08_mapping_inputs_result/s08_component_"<>IntegerString[component,10,4]<>".wl";
inputPath=FileNameJoin[{root,inputRelative}];
inputReceiptPath=FileNameJoin[{DirectoryName[inputPath],"s08_recovery_execution.json"}];
inputReceipt=Import[inputReceiptPath,"RawJSON"];
gate["accepted exact native equation",TrueQ[inputReceipt["passed"]]&&inputReceipt["result_sha256"][inputRelative]===IntegerString[FileHash[inputPath,"SHA256"],16,64]];
record=Get[inputPath];
gate["complete native equation contract",record["Schema"]==="polarized-sidis-native-mapping-input-v1"&&record["Channel"]===channel&&record["Component"]===component&&And@@Values[record["Checks"]]&&record["NativeVersions"]==={$Version,FeynCalc`$FeynCalcVersion}];
KeyValueMap[Function[{name,hash},gate["unchanged equation input "<>name,FileHash[FileNameJoin[{root,name}],"SHA256"]===hash]],record["InputHashes"]];
geometry=record["Geometry"];denominators=record["Denominators"];directions=record["Directions"];families=record["Families"];familyNames=Keys[families];
mapper=FileNameJoin[{root,"common","s08_result","reference","s08_map_real_spin_before_known_denominator.wls"}];
gate["original reference mapper identity",IntegerString[FileHash[mapper,"SHA256"],16,64]==="e23a79589bfce183535a6f1166eda799a9f119168feb9cff1b13feb669c8b21f"];
mapperText=Import[mapper,"Text"];starts=StringPosition[mapperText,"\nmerge[pieces_List]"];ends=StringPosition[mapperText,"\ncoefficientPath ="];
gate["unique original mapping block",Length[starts]===1&&Length[ends]===1];
mappingBlock=StringTake[mapperText,{First[First[starts]],First[First[ends]]-1}];gate["original mapping syntax",SyntaxQ[mappingBlock]];ToExpression[mappingBlock,InputForm];
gate["unchanged complete original mapping functions",DownValues[mapExpression]===record["OriginalMappingDefinitions"]&&DownValues[familyRows]===record["OriginalFamilyDefinitions"]&&DownValues[merge]===record["OriginalMergeDefinitions"]];
termOriginalFamily=DownValues[familyRows];
proofRelative="Hqg/s08_polynomial_group_result/s08_result.wl";proofPath=FileNameJoin[{root,proofRelative}];
proofReceipt=Import[FileNameJoin[{DirectoryName[proofPath],"s08_execution.json"}],"RawJSON"];
gate["accepted polynomial family execution",TrueQ[proofReceipt["passed"]]&&proofReceipt["result_sha256"][proofRelative]===IntegerString[FileHash[proofPath,"SHA256"],16,64]];
proof=Get[proofPath];
gate["identical scalar polynomial mapping contract",TrueQ[proof["Accepted"]]&&TrueQ[proof["OwnAcceptedComparison"]]&&And@@Values[proof["Checks"]]&&proof["NativeVersions"]==={$Version,FeynCalc`$FeynCalcVersion}&&proof["OriginalFamilyDefinitions"]===termOriginalFamily&&proof["MapperHash"]===FileHash[mapper,"SHA256"]&&proof["SourceHash"]===FileHash[FileNameJoin[{root,"common","s08_map_Hqg_polynomial_group.wls"}],"SHA256"]&&KeyDrop[proof["InputHashes"],"Hqg/s05_result/s05_result.wl"]===KeyDrop[record["InputHashes"],channel<>"/s05_result/s05_result.wl"]];
DownValues[familyRows]=proof["CandidateFamilyDefinitions"];polynomialVariables=proof["PolynomialVariables"];
DownValues[saveNative]=proof["PieceStorageDefinitions"];
DownValues[certifyPairMerge]=record["MergeCertificateDefinitions"];
DownValues[certifyGroupMerge]=record["GroupMergeDefinitions"];
DownValues[pairReconstruct]=record["ReconstructionDefinitions"];
gate["exact executed polynomial and merge definitions installed",DownValues[familyRows]===proof["CandidateFamilyDefinitions"]&&DownValues[certifyPairMerge]===record["MergeCertificateDefinitions"]&&DownValues[certifyGroupMerge]===record["GroupMergeDefinitions"]&&DownValues[pairReconstruct]===record["ReconstructionDefinitions"]];
If[channel==="Hgg",
 ownProofRelative="Hqg/s08_termwise_comparison_result/s08_result.wl";ownProofPath=FileNameJoin[{root,ownProofRelative}];
 ownReceipt=Import[FileNameJoin[{DirectoryName[ownProofPath],"s08_execution.json"}],"RawJSON"];
 gate["accepted complete termwise control execution",TrueQ[ownReceipt["passed"]]&&ownReceipt["result_sha256"][ownProofRelative]===IntegerString[FileHash[ownProofPath,"SHA256"],16,64]];
 ownProof=Get[ownProofPath];
 gate["same executed complete termwise algorithm",TrueQ[ownProof["OwnAcceptedComparison"]]&&And@@Values[ownProof["Checks"]]&&ownProof["SourceHash"]===FileHash[source,"SHA256"]&&ownProof["NativeVersions"]==={$Version,FeynCalc`$FeynCalcVersion}&&ownProof["PolynomialProofHash"]===FileHash[proofPath,"SHA256"]]];
terms=If[Head[record["Expression"]]===Plus,List@@record["Expression"],{record["Expression"]}];
gate["entire original additive input unchanged",Total[terms]===record["Expression"]];
gate["actual input has multiple original terms",Length[terms]>1];
Print["ORIGINAL_ADDITIVE_INPUT ",InputForm[<|"Channel"->channel,"Component"->component,"Count"->Length[terms],"Bytes"->ByteCount/@terms|>]];
termHash=Hash[{FileHash[source,"SHA256"],FileHash[inputPath,"SHA256"],FileHash[proofPath,"SHA256"],$Version,FeynCalc`$FeynCalcVersion},"SHA256"];
termCache=FileNameJoin[{root,"cache","s08_original_terms",channel,IntegerString[termHash,16]}];If[!DirectoryQ[termCache],CreateDirectory[termCache,CreateIntermediateDirectories->True]];
termCompareOriginal=(channel==="Hgg");
termMap[packet_]:=Catch[Block[{checks=<||>},Module[{index,value,binding,path,saved,seconds,coefficients,original,originalSeconds=0},
 index=packet["Index"];value=packet["Value"];binding=Hash[{termHash,index,value},"SHA256"];
 path=FileNameJoin[{termCache,"term_"<>IntegerString[index,10,5]<>".wl"}];saved=If[FileExistsQ[path],Get[path],<||>];
 If[Lookup[saved,"Binding",None]===binding&&TrueQ[Lookup[saved,"Accepted",False]]&&AssociationQ[Lookup[saved,"Checks",None]]&&Length[saved["Checks"]]>0&&And@@Values[saved["Checks"]],Return[saved]];
 Print["ORIGINAL_TERM_START ",index," bytes ",ByteCount[value]," kernel ",$KernelID];
 If[termCompareOriginal,{originalSeconds,original}=AbsoluteTiming[bounded[Block[{familyRows},DownValues[familyRows]=termOriginalFamily;mapExpression[value]],{"original own term",index}]]];
 {seconds,coefficients}=AbsoluteTiming[bounded[mapExpression[value],{"polynomial own term",index}]];
 If[termCompareOriginal,gate["every original own term coefficient reproduced",Sort[Keys[coefficients]]===Sort[Keys[original]]&&And@@KeyValueMap[zero[#2-original[#1]]&,coefficients]]];
 saved=<|"Binding"->binding,"Index"->index,"Accepted"->True,"Coefficients"->coefficients,"Checks"->checks,"Seconds"->seconds,"OriginalSeconds"->originalSeconds,"ComparedOriginal"->termCompareOriginal,"InputBytes"->ByteCount[value]|>;
 saveNative[saved,path];Print["ORIGINAL_TERM_DONE ",index," seconds ",seconds," original_seconds ",originalSeconds];saved]],"TermFailure"];
slots=Quiet[Check[ToExpression[Environment["NSLOTS"]],1]];If[!IntegerQ[slots]||slots<1,slots=1];CloseKernels[];
If[slots>1,TimeConstrained[LaunchKernels[KernelConfiguration["localhost","KernelCommand"->"/u/local/apps/mathematica/13.1/Executables/WolframKernel","KernelCount"->Min[8,slots],"TimeConstraint"->60]],60,$Failed]];
workers=Length[Kernels[]];
If[workers>0,
 gate["workers share allocated node",And@@(SameQ[#,$MachineName]&/@ParallelEvaluate[$MachineName])];
 ParallelEvaluate[$HistoryLength=0;checks=<||>;PrependTo[$Path,"/u/home/r/rushil/.Mathematica/Applications"];$FeynCalcStartupMessages=False;Get["FeynCalc`"]];
 gate["workers share native versions",And@@(SameQ[#,{$Version,FeynCalc`$FeynCalcVersion}]&/@ParallelEvaluate[{$Version,FeynCalc`$FeynCalcVersion}])];
 DistributeDefinitions[gate,bounded,zero,merge,decompose,extractAtoms,familyRows,mapExpression,saveNative,polynomialVariables,geometry,denominators,directions,families,familyNames,termOriginalFamily,termHash,termCache,termCompareOriginal,termMap]];
$DistributedContexts=None;
packets=MapIndexed[<|"Index"->First[#2],"Value"->#1|>&,terms];
{mappingSeconds,mapped}=AbsoluteTiming[If[workers>0,ParallelMap[termMap,packets,Method->"FinestGrained"],termMap/@packets]];
CloseKernels[];
gate["every original term mapped exactly once",Length[mapped]===Length[terms]&&AllTrue[mapped,AssociationQ]&&Lookup[mapped,"Index"]===Range[Length[terms]]&&And@@Lookup[mapped,"Accepted"]&&And@@Flatten[Values[#["Checks"]]&/@mapped]];
If[termCompareOriginal,gate["complete own original termwise output comparison",And@@Lookup[mapped,"ComparedOriginal"]]];
Print["ORIGINAL_TERMS_MERGE ",Length[mapped]];
{mergeSeconds,coefficients}=AbsoluteTiming[bounded[merge[Lookup[mapped,"Coefficients"]],"original reference term merge"]];
gate["complete termwise map reconstructs",bounded[certifyGroupMerge[mapped,coefficients],"exact full term merge certificate"]];
gate["both physical cuts retained",And@@(Take[#[[2]],2]===ConstantArray[1,Length[geometry["CutMomenta"]]]&/@Keys[coefficients])];
If[channel==="Hqg",
 controlPath=FileNameJoin[{root,"cache","s08_targets",channel,IntegerString[record["TargetInputHash"],16],"component_"<>IntegerString[component,10,4]<>".wl"}];control=Get[controlPath];
 gate["accepted own full component identity",control["InputHash"]===record["TargetInputHash"]&&TrueQ[control["ReconstructionPassed"]]&&And@@Values[control["Checks"]]&&KeyTake[control,{"Sector","Kind","Index"}]===record["Task"]];
 gate["entire accepted own component map reproduced",coefficients===control["Coefficients"]||bounded[zero[pairReconstruct[coefficients]-pairReconstruct[control["Coefficients"]]],"entire accepted own map comparison"]]];
result=<|"Schema"->"polarized-sidis-original-term-map-v1","Channel"->channel,"Component"->component,"Task"->record["Task"],"Coefficients"->coefficients,"InputHash"->record["TargetInputHash"],"InputHashes"->record["InputHashes"],"NativeInputHash"->FileHash[inputPath,"SHA256"],"NativeInputReceiptHash"->FileHash[inputReceiptPath,"SHA256"],"SourceHash"->FileHash[source,"SHA256"],"MapperHash"->FileHash[mapper,"SHA256"],"PolynomialProofHash"->FileHash[proofPath,"SHA256"],"TermHash"->termHash,"TermEvidence"->(KeyDrop[#,"Coefficients"]&/@mapped),"MappingSeconds"->mappingSeconds,"MergeSeconds"->mergeSeconds,"OwnAcceptedComparison"->True,"ComparisonKind"->If[termCompareOriginal,"EveryOriginalTermAndCompleteLinearMerge","EntireAcceptedComponentMap"],"ReconstructionPassed"->True,"NativeVersions"->{$Version,FeynCalc`$FeynCalcVersion},"Checks"->checks,"FiniteNLOFHatsComputed"->False|>;
directory=FileNameJoin[{root,channel,"s08_termwise_comparison_result"}];If[!DirectoryQ[directory],CreateDirectory[directory,CreateIntermediateDirectories->True]];
saveNative[result,FileNameJoin[{directory,"s08_result.wl"}]];
Export[FileNameJoin[{directory,"s08_checks.json"}],<|"channel"->channel,"component"->component,"checks"->checks,"terms"->Length[terms],"mapping_seconds"->mappingSeconds,"merge_seconds"->mergeSeconds,"comparison"->result["ComparisonKind"],"job_id"->Environment["JOB_ID"],"finite_nlo_fhats_computed"->False|>,"RawJSON"];
Print["PASS: s08_map_saved_terms"];Quit[0];
