(* Restore original reduced Hermiticity and reuse native structural spin extraction. *)
$HistoryLength=0;
reducedProjectionSource=FileNameJoin[{Directory[],"common","s05_project_Hgg_reduced_hermiticity.wls"}];
reducedProjectionBase=FileNameJoin[{Directory[],"common","s05_project_Hgg_termwise_spin.wls"}];
If[IntegerString[FileHash[reducedProjectionBase,"SHA256"],16,64]=!=
 "65c3ef36f71171068a4f111238d5ec48ab7a49938c70ea5f00c3605e0a71d276" ||
 !SyntaxQ[Import[reducedProjectionSource,"Text"]],Quit[1]];
reducedProjectionText=StringTrim[Import[reducedProjectionBase,"Text"]];
reducedProjectionTerminal="ToExpression[termwiseRun, InputForm];";
If[!StringEndsQ[reducedProjectionText,reducedProjectionTerminal],Quit[1]];
reducedProjectionPrefix=StringDrop[reducedProjectionText,-StringLength[reducedProjectionTerminal]];
If[!SyntaxQ[reducedProjectionPrefix],Quit[1]];
ToExpression[reducedProjectionPrefix,InputForm];
reducedProjectionChanges={
 "  controlPath = FileNameJoin[{root, First[assemblyManifest[\"pairs\"]][\"file\"]}];"->"hggProjectionStructuralPath = FileNameJoin[{root, \"Hqq\", \"s05_structural_reconstruction_result\", \"s05_result.wl\"}];\ngate[\"pinned accepted structural spin algorithm\", IntegerString[FileHash[hggProjectionStructuralPath, \"SHA256\"], 16, 64] ===\n  \"b8d397e29a9b9210e2d4db1aabf361eb5ece0c338bbe0c93d0fd846fc8be44de\"];\nhggProjectionStructuralProof = Get[hggProjectionStructuralPath];\nhggProjectionStructuralSource = FileNameJoin[{root, \"common\", \"s05_check_structural_reconstruction.wls\"}];\ngate[\"accepted structural definitions and native extraction\", TrueQ[hggProjectionStructuralProof[\"Accepted\"]] &&\n  And @@ Values[hggProjectionStructuralProof[\"Checks\"]] && hggProjectionStructuralProof[\"NativeVersions\"] === {$Version, $FeynCalcVersion} &&\n  hggProjectionStructuralProof[\"SourceHash\"] === FileHash[hggProjectionStructuralSource, \"SHA256\"] &&\n  hggProjectionStructuralProof[\"ExtractionDefinitions\"] === DownValues[compactSpinResponse]];\nhggProjectionStructuralDefinition = sourceSection[Import[hggProjectionStructuralSource, \"Text\"],\n  \"\\nstructuralSpinReconstruction[expression_\", \"\\nmeasurements =\"];\ngate[\"complete original structural definition syntax\", SyntaxQ[hggProjectionStructuralDefinition]];\nToExpression[hggProjectionStructuralDefinition, InputForm];\ngate[\"same executed structural reconstruction\", DownValues[structuralSpinReconstruction] === hggProjectionStructuralProof[\"CandidateDefinitions\"]];\nhggProjectionExtractionChanges = {\n  \"structuralSpinReconstruction[expression_, response_, incoming_, outgoing_]\" ->\n    \"structuralSpinExtraction[expression_, incoming_, outgoing_]\",\n  \",\\n    \\\"ExactExistingResponse\\\" -> (restored === response)\" -> \"\",\n  \"<|\\\"Accepted\\\" -> (And @@ Values[evidence]), \\\"Checks\\\" -> evidence,\" ->\n    \"<|\\\"Response\\\" -> restored, \\\"Accepted\\\" -> (And @@ Values[evidence]), \\\"Checks\\\" -> evidence,\"};\ngate[\"unique structural extraction interfaces\", And @@ (StringCount[hggProjectionStructuralDefinition, First[#]] === 1 & /@ hggProjectionExtractionChanges)];\nhggProjectionExtractionDefinition = StringReplace[hggProjectionStructuralDefinition, hggProjectionExtractionChanges];\nhggProjectionExtractionRestored = StringReplace[hggProjectionExtractionDefinition, {\n  Last[hggProjectionExtractionChanges[[1]]] -> First[hggProjectionExtractionChanges[[1]]],\n  Last[hggProjectionExtractionChanges[[3]]] -> First[hggProjectionExtractionChanges[[3]]],\n  \"AssociateTo[evidence, {\\\"ExactAbstractReconstruction\\\" -> (Expand[opaque - reconstructed] === 0)}];\" ->\n    \"AssociateTo[evidence, {\\\"ExactAbstractReconstruction\\\" -> (Expand[opaque - reconstructed] === 0),\\n    \\\"ExactExistingResponse\\\" -> (restored === response)}];\"}];\ngate[\"complete original structural derivation retained\", SyntaxQ[hggProjectionExtractionDefinition] &&\n  hggProjectionExtractionRestored === hggProjectionStructuralDefinition];\nToExpression[hggProjectionExtractionDefinition, InputForm];\nhggProjectionExtractOne[expression_, incoming_, outgoing_] := Module[{packet},\n  packet = structuralSpinExtraction[expression, incoming, outgoing];\n  gate[\"complete structural extraction reconstruction\", TrueQ[packet[\"Accepted\"]] && And @@ Values[packet[\"Checks\"]]];\n  packet[\"Response\"]];\n\nhggReducedHermiticity[left_,right_] := Module[{difference,reduced,seconds},\n difference=left-streamedRealConjugate[right];\n Print[\"HERMITICITY_RESIDUAL input_bytes \",ByteCount[difference]];\n {seconds,reduced}=AbsoluteTiming[algebraicReduce[difference]];\n Print[\"HERMITICITY_REDUCED seconds \",seconds,\" output_bytes \",ByteCount[reduced]];\n zeroArray[reduced]];\n  controlPath = FileNameJoin[{root, First[assemblyManifest[\"pairs\"]][\"file\"]}];",
 "zeroArray[entries[key] - streamedRealConjugate[\n      entries[\"Photon_\" <> StringRiffle[ToString /@ Reverse[position], \"_\"]]]]"->"hggReducedHermiticity[entries[key],\n      entries[\"Photon_\" <> StringRiffle[ToString /@ Reverse[position], \"_\"]]]",
 "  {conjugationSeconds, ownConjugate} = AbsoluteTiming[bounded["->"  gate[\"own complete structural spin response exactly reproduced\",bounded[\n    hggProjectionExtractOne[controlPhoton,inVariables,outVariables]===controlResponse,\n    \"own structural spin extraction comparison\"]];\n  gate[\"own complete reduced Hermiticity reproduced\",bounded[\n    And@@Flatten[Table[hggReducedHermiticity[control[\"PhotonMatrix\"][[i,j]],control[\"PhotonMatrix\"][[j,i]]],\n      {i,shape[[1]]},{j,shape[[2]]}]],\"own reduced Hermiticity comparison\"]];\n  {conjugationSeconds, ownConjugate} = AbsoluteTiming[bounded[",
 "bounded[streamedSpinResponse[photon, inVariables, outVariables], \"complete termwise spin extraction\"]"->"bounded[hggProjectionExtractOne[photon, inVariables, outVariables], \"complete structural spin extraction\"]",
 "\"ConjugationDispatchHash\" -> FileHash[termwiseSource, \"SHA256\"],"->"\"ConjugationDispatchHash\" -> FileHash[termwiseSource, \"SHA256\"],\n    \"ReductionDispatchHash\" -> FileHash[reducedProjectionSource,\"SHA256\"],"};
If[!And@@(StringCount[termwiseRun,First[#]]===1&/@reducedProjectionChanges),
 Print["FAIL: unique reduced projection interfaces"];Quit[1]];
reducedProjectionRun=StringReplace[termwiseRun,reducedProjectionChanges];
If[!SyntaxQ[reducedProjectionRun] || StringReplace[reducedProjectionRun,Reverse/@reducedProjectionChanges]=!=termwiseRun,
 Print["FAIL: unchanged remaining projection equations"];Quit[1]];
ToExpression[reducedProjectionRun,InputForm];
