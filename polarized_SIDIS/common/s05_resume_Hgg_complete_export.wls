(* Finish the unchanged complete-export reader checks from its saved checkpoint. *)
$HistoryLength=0; root=Directory[]; channel="Hgg"; checks=<||>;
source=FileNameJoin[{root,"common","s05_resume_Hgg_complete_export.wls"}];
configPath=FileNameJoin[{root,"common","s05_Hgg_export_resume_inputs.json"}];
gate[name_,test_]:=If[TrueQ[test],AssociateTo[checks,name->True];Print["PASS: ",name],Print["FAIL: ",name];Quit[1]];
SetAttributes[readBound,HoldFirst];
readBound[value_,label_]:=MemoryConstrained[TimeConstrained[value,1200,gate[ToString[{label,"read time"},InputForm],False]],16*1024^3,gate[ToString[{label,"read memory"},InputForm],False]];
gate["compute allocation",StringQ[Environment["JOB_ID"]]&&!StringStartsQ[$MachineName,"login"]&&StringStartsQ[$UserBaseDirectory,root<>"/"]];
gate["complete continuation syntax",SyntaxQ[Import[source,"Text"]]];
PrependTo[$Path,"/u/home/r/rushil/.Mathematica/Applications"];$FeynCalcStartupMessages=False;Get["FeynCalc`"];
cfg=Import[configPath,"RawJSON"];
gate["checkpoint contract",cfg["schema"]==="polarized-sidis-export-checkpoint-resume-inputs-v1"&&cfg["channel"]===channel];
KeyValueMap[Function[{key,row},gate["checkpoint identity "<>key,IntegerString[FileHash[FileNameJoin[{root,row["file"]}],"SHA256"],16,64]===row["sha256"]]],cfg["files"]];
prior=Import[FileNameJoin[{root,cfg["files"]["execution"]["file"]}],"RawJSON"];
gate["only interrupted export resumed",prior["job_id"]===cfg["prior_job"]&&!TrueQ[prior["passed"]]&&prior["reason"]==="wall_limit"];
originalPath=FileNameJoin[{root,cfg["original_source"]}];
gate["same reviewed complete exporter",IntegerString[FileHash[originalPath,"SHA256"],16,64]===cfg["original_source_sha256"]&&prior["reviewed_sha256"][cfg["original_source"]]===cfg["original_source_sha256"]];
KeyValueMap[Function[{name,hash},gate["unchanged original input "<>name,IntegerString[FileHash[FileNameJoin[{root,name}],"SHA256"],16,64]===hash]],prior["reviewed_sha256"]];
metadataPath=FileNameJoin[{root,channel,"s05_result","s05_metadata.wl"}];
gate["saved metadata bound by execution",prior["result_sha256"][channel<>"/s05_result/s05_metadata.wl"]===cfg["files"]["metadata"]["sha256"]&&IntegerString[FileHash[metadataPath,"SHA256"],16,64]===cfg["files"]["metadata"]["sha256"]];
metadata=readBound[Get[metadataPath],"saved complete metadata"];
gate["original metadata and accepted algebra",AssociationQ[metadata]&&metadata["Schema"]==="polarized-sidis-real-response-v1"&&metadata["Channel"]===channel&&And@@Values[metadata["Checks"]]&&metadata["ComponentExportSourceHash"]===FileHash[originalPath,"SHA256"]];
label=metadata["ComponentStorage"]["Sector"];sector=metadata["Sectors"][label];
gate["original complete reference comparisons",And@@(TrueQ[metadata["Checks"][#]]&/@{label<>" reference Pg",label<>" reference Ppp","executed complete real photon definition","all matrix entries covered by native Hermiticity checks"})];
checks=Join[metadata["Checks"],checks];
records=metadata["ComponentStorage"]["PhotonFiles"];metricRow=metadata["ComponentStorage"]["MetricFile"];
hggFileRow[relative_]:=<|"File"->relative,"Hash"->FileHash[FileNameJoin[{root,relative}],"SHA256"]|>;
gate["complete photon inventory",Length[records]===Length[metadata["PhotonLabels"]]&&DuplicateFreeQ[Lookup[records,"File"]]];
Do[gate["unchanged photon input "<>ToString[i],FileHash[FileNameJoin[{root,records[[i]]["File"]}],"SHA256"]===records[[i]]["Hash"]],{i,Length[records]}];
gate["unchanged dimensional metric input",FileHash[FileNameJoin[{root,metricRow["File"]}],"SHA256"]===metricRow["Hash"]];
originalText=Import[originalPath,"Text"];
starts=StringPosition[originalText,"  reader = \"Module"];ends=StringPosition[originalText,"  gate[\"native component reader syntax\""];
gate["unique original reader construction",Length[starts]===1&&Length[ends]===1&&First[First[starts]]<First[First[ends]]];
construction=StringTake[originalText,{First[First[starts]],First[First[ends]]-1}];
gate["unchanged reader construction syntax",SyntaxQ[construction]];ToExpression[construction,InputForm];
directory=DirectoryName[metadataPath];resultPath=FileNameJoin[{directory,"s05_result.wl"}];
temporary=resultPath<>".resume.tmp";Export[temporary,reader,"Text"];
gate["exact previously exercised native reader export",FileHash[temporary,"SHA256"]===FileHash[FileNameJoin[{root,cfg["files"]["reader"]["file"]}],"SHA256"]&&SyntaxQ[reader]];
log=Import[FileNameJoin[{root,cfg["files"]["log"]["file"]}],"Text"];
completed=StringCases[log,"exact accepted response through loader "~~n:(DigitCharacter..):>FromDigits[n]];
gate["only contiguous executed comparisons reused",StringFreeQ[log,"FAIL:"]&&completed===cfg["previous_reader_components"]&&completed===Range[Length[completed]]&&Length[completed]<=Length[records]];
loaded=Get[temporary];
gate["exact complete metadata interface",KeyDrop[loaded,"Sectors"]===KeyDrop[metadata,"Sectors"]&&KeyTake[loaded["Sectors"][label],Keys[sector]]===sector];
Do[gate["resumed exact accepted response through loader "<>ToString[i],MemberQ[completed,i]],{i,completed}];
remaining=Complement[Range[Length[records]],completed];
Do[
 Print["RESUME_COMPLETE_RESPONSE ",i];
 expected=readBound[Get[FileNameJoin[{root,records[[i]]["File"]}]]["Response"],{"accepted response",i}];
 actual=readBound[loaded["Sectors"][label]["ExtendedResponseComponent"][i],{"original reader",i}];
 gate["exact accepted response through loader "<>ToString[i],actual===expected];
 Clear[actual,expected];ClearSystemCache[],{i,remaining}];
expected=readBound[Get[FileNameJoin[{root,metricRow["File"]}]]["Value"],"accepted metric"];
gate["exact dimensional metric through loader",readBound[loaded["Sectors"][label]["PhotonMetricD"],"original metric reader"]===expected];
Clear[expected,loaded];ClearSystemCache[];
gate["unchanged metadata after reader checks",IntegerString[FileHash[metadataPath,"SHA256"],16,64]===cfg["files"]["metadata"]["sha256"]];
RenameFile[temporary,resultPath,OverwriteTarget->True];
scalarFiles=Select[Keys[prior["result_sha256"]],StringStartsQ[#,channel<>"/s05_component_sums_result/Scalar_"]&&StringEndsQ[#,"/s05_result.wl"]&];
Do[gate["unchanged accepted scalar "<>name,IntegerString[FileHash[FileNameJoin[{root,name}],"SHA256"],16,64]===prior["result_sha256"][name]],{name,scalarFiles}];
payloadRows=Join[records,hggFileRow/@scalarFiles,{hggFileRow[channel<>"/s05_result/s05_metadata.wl"]}];
manifest=<|"schema"->"polarized-sidis-component-native-result-v1","result"->channel<>"/s05_result/s05_result.wl","result_sha256"->IntegerString[FileHash[resultPath,"SHA256"],16,64],"exact_component_round_trips"->True,"payloads"->(<|"file"->#["File"],"sha256"->IntegerString[#["Hash"],16,64],"bytes"->FileByteCount[FileNameJoin[{root,#["File"]}]]|>&/@payloadRows)|>;
Export[FileNameJoin[{directory,"s05_component_manifest.json"}],manifest,"RawJSON"];
report=<|"channel"->channel,"checks"->checks,"sectors"->{label},"component_count"->Length[records],"mapping_task_count"->Length[metadata["MappingTaskSources"]],"peak_kernel_memory_bytes"->MaxMemoryUsed[],"finite_nlo_fhats_computed"->False,"job_id"->Environment["JOB_ID"]|>;
Export[FileNameJoin[{directory,"s05_checks.json"}],report,"RawJSON"];
proof=<|"Schema"->"polarized-sidis-complete-export-resume-v1","Channel"->channel,"SourceHash"->FileHash[source,"SHA256"],"ConfigHash"->FileHash[configPath,"SHA256"],"OriginalSourceHash"->FileHash[originalPath,"SHA256"],"MetadataHash"->FileHash[metadataPath,"SHA256"],"ReaderHash"->FileHash[resultPath,"SHA256"],"ReusedReaderComponents"->completed,"CompletedReaderComponents"->remaining,"NativeVersions"->{$Version,$FeynCalcVersion},"Checks"->checks,"FiniteNLOFHatsComputed"->False|>;
proofPath=FileNameJoin[{root,channel,"s05_export_resume_result","s05_result.wl"}];
Put[proof,proofPath<>".tmp"];gate["exact continuation proof reload",Get[proofPath<>".tmp"]===proof];RenameFile[proofPath<>".tmp",proofPath,OverwriteTarget->True];
Print["PASS: s05_resume_Hgg_complete_export"];Quit[0];
