t/download/table/ins647847/Table 11/root","yaml":"https://www.hepdata.net/download/table/ins647847/Table 11/yaml","yoda":"https://www.hepdata.net/download/table/ins647847/Table 11/yoda","yoda.h5":"https://www.hepdata.net/download/table/ins647847/Table 11/yoda.h5","yoda1":"https://www.hepdata.net/download/table/ins647847/Table 11/yoda1"},"description":"The inclusive PI0 cross section as a function of the scaled pion energy in 3 regions of Q**2.","doi":"10.17182/hepdata.46278.v1/t11","id":39885,"location":"Data from T 3,F 6","messages":false,"name":"Table 11","processed_name":"Table11","resources":[]}],"mode":"record","overall_status":"finished","participant_count":0,"recid":46278,"record":{"abstract":"Deep-inelastic positron-proton interactions at low values of Bjorken-x down to x \\approx 4.10^-5 which give rise to high transverse momentum pi^0 mesons are studied with the H1 experiment at HERA. The inclusive cross section for pi^0 mesons produced at small angles with respect to the proton remnant (the forward region) is presented as a function of the transverse momentum and energy of the pi^0 and of the four-momentum transfer Q^2 and Bjorken-x. Measurements are also presented of the transverse energy flow in events containing a forward pi^0 meson. Hadronic final state calculations based on QCD models implementing different parton evolution schemes are confronted with the data.","access_urls":{"links":{"csv":"https://www.hepdata.net/download/submission/ins647847/1/csv","json":"https://www.hepdata.net/download/submission/ins647847/1/json","root":"https://www.hepdata.net/download/submission/ins647847/1/root","yaml":"https://www.hepdata.net/download/submission/ins647847/1/yaml","yoda":"https://www.hepdata.net/download/submission/ins647847/1/yoda"}},"analyses":[],"arxiv_id":"arXiv:hep-ex/0404009","collaborations":["H1"],"control_number":"46278","creation_date":"2004-04-01","data_abstract":"DESY-HERA. Measurement of the cross sections for forward PI0 production in DIS interactions of 27.6 GeV positrons with 820 GeV protons. The inclusive cross sections for PI0 produced at small angles (5 to 25 degrees) w.r.t. the proton remnant is presented as a function of the transverse momentum and energy of the PI0, and of the Q**2 and Bjorken-X. The data come from the 1996 and 1997 HERA running periods with an integrated luminosity of 21.2 pb-1.","data_keywords":{"cmenergies":[{"gte":0.0,"lte":0.0}],"observables":["DSIG/DPT","DSIG/DX"],"phrases":["Transverse Momentum Dependence","Inclusive","Neutral Current","Electron production","Single Differential Cross Section","Deep Inelastic Scattering"],"reactions":["E+ P --> E+ PI0 X"]},"doc_type":"publication","doi":"10.1140/epjc/s2004-01983-1","first_author":{"affiliation":"","full_name":"Aktas, A."},"hepdata_doi":"10.17182/hepdata.46278.v1","id":46278,"inspire_id":647847,"journal_info":"Eur.Phys.J.C 36 (2004) 441-452","keywords":[{"schema":"INSPIRE","value":"positron p: colliding beams"},{"schema":"INSPIRE","value":"positron p: deep inelastic scattering"},{"schema":"INSPIRE","value":"pi0: electroproduction"},{"schema":"INSPIRE","value":"transverse momentum: high"},{"schema":"INSPIRE","value":"small-angle"},{"schema":"INSPIRE","value":"differential cross section: transverse momentum"},{"schema":"INSPIRE","value":"energy dependence"},{"schema":"INSPIRE","value":"momentum transfer dependence"},{"schema":"INSPIRE","value":"x-dependence"},{"schema":"INSPIRE","value":"transverse energy: energy flow"},{"schema":"INSPIRE","value":"quantum chromodynamics: perturbation theory"},{"schema":"INSPIRE","value":"DGLAP equation"},{"schema":"INSPIRE","value":"Lipatov equation"},{"schema":"INSPIRE","value":"CCFM equation"},{"schema":"INSPIRE","value":"color: dipole"},{"schema":"INSPIRE","value":"H1"},{"schema":"INSPIRE","value":"experimental results"},{"schema":"INSPIRE","value":"DESY HERA Stor"},{"schema":"INSPIRE","value":"approx. 300 GeV-cms"}],"last_updated":"Mon, 19 Apr 2004 00:00:00 GMT","parent_child_join":{"nam