<|GLI["SE", {1, 1, 0, 0}] -> 
  <|"Tuple" -> {I*Pi^(2 - eps)*Gamma[eps], (1 + x[1])^(-2 + 2*eps)/
      (Q2*x[1])^eps, {x[1]}, {Q2}}, "FeynmanRepresentation" -> 
    {(x[1] + x[2])^(-2 + 2*eps)/(Q2*x[1]*x[2])^eps, 
     I*Pi^(2 - eps)*Gamma[eps], {x[1], x[2]}}, "RadialNormalization" -> 
    Missing["NotRadialTadpole"]|>, GLI["UV", {1, 0, 0, 0}] -> 
  <|"Tuple" -> {((-I)*Pi^((4 - 2*eps)/2))/Gamma[(4 - 2*eps)/2], 
     yy^(-1 + (4 - 2*eps)/2)/(M2 + yy), {yy}, {M2}}, 
   "FeynmanRepresentation" -> {1, (-I)*M2^(1 - eps)*Pi^(2 - eps)*
      Gamma[-1 + eps], {}}, "RadialNormalization" -> 
    (-I)*M2^(1 - eps)*Pi^(2 - eps)*Gamma[-1 + eps]|>|>
